<?xml version="1.0" encoding="UTF-8"?>
<!-- Web, лабораторные работы № 2, 3, 5, 6: дескриптор развёртывания. -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <display-name>Картотека выдач</display-name>

  <!-- Фильтры выполняются в порядке объявления: сначала язык и кодировка, затем доступ -->
  <filter>
    <filter-name>locale</filter-name>
    <filter-class>edu.java.issues.web.LocaleFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>locale</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>auth</filter-name>
    <filter-class>edu.java.issues.web.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>auth</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Web 3: сервлет с параметрами инициализации -->
  <servlet>
    <servlet-name>issueServlet</servlet-name>
    <servlet-class>edu.java.issues.web.IssueServlet</servlet-class>
    <init-param>
      <param-name>titleKey</param-name>
      <param-value>servlet.title</param-value>
    </init-param>
    <init-param>
      <param-name>maxRows</param-name>
      <param-value>50</param-value>
    </init-param>
  </servlet>
  <servlet-mapping>
    <servlet-name>issueServlet</servlet-name>
    <url-pattern>/servlet/issues</url-pattern>
  </servlet-mapping>

  <!-- Web 5 и 7: контроллер страницы JSP и страница выбора читателя -->
  <servlet>
    <servlet-name>issuesController</servlet-name>
    <servlet-class>edu.java.issues.web.IssuesController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>issuesController</servlet-name>
    <url-pattern>/issues</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>askReader</servlet-name>
    <servlet-class>edu.java.issues.web.AskReaderServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>askReader</servlet-name>
    <url-pattern>/ask-reader</url-pattern>
  </servlet-mapping>

  <!-- Web 6: вход и выход -->
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>edu.java.issues.web.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet>
    <servlet-name>logout</servlet-name>
    <servlet-class>edu.java.issues.web.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>logout</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <!-- Web 8: служба GWT-RPC -->
  <servlet>
    <servlet-name>gwtIssueService</servlet-name>
    <servlet-class>edu.java.issues.gwt.server.IssueServiceImpl</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>gwtIssueService</servlet-name>
    <url-pattern>/gwt-app/issuegwt/issueService</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>

  <!-- Страницы и подключаемые фрагменты JSP читаются в кодировке UTF-8 -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <trim-directive-whitespaces>true</trim-directive-whitespaces>
    </jsp-property-group>
  </jsp-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <error-page>
    <error-code>403</error-code>
    <location>/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/error.jsp</location>
  </error-page>
</web-app>
